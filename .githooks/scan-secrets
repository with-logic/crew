#!/bin/sh
# Scan staged Git changes; never install tools during a commit.
# Usage: scan-secrets (no arguments), from a Git checkout. Zero means clean or
# no staged changes; nonzero blocks the commit on findings or scanner errors.
set -eu
export GIT_NO_LAZY_FETCH=1
# Keep findings distinct from scanner failures.
readonly GITLEAKS_FINDING_EXIT_CODE=20

HOOK_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
cd "$(git rev-parse --show-toplevel)"
DIFF_STATUS=0
git diff --cached --quiet --exit-code || DIFF_STATUS=$?
[ "$DIFF_STATUS" -ne 0 ] || exit 0
[ "$DIFF_STATUS" -eq 1 ] || exit "$DIFF_STATUS"

for POLICY in .gitleaks.toml .gitleaksignore; do
    if [ -e "$POLICY" ] || git ls-files --error-unmatch -- "$POLICY" >/dev/null 2>&1; then
        if ! git ls-files --error-unmatch -- "$POLICY" >/dev/null 2>&1 ||
           ! git diff --quiet -- "$POLICY"; then
            echo "Stage policy changes to $POLICY before committing; the scanner reads checkout policy." >&2
            exit 1
        fi
    fi
done

if ! command -v gitleaks >/dev/null 2>&1; then
    echo 'Secret scan requires Gitleaks. Install it once with: brew install gitleaks' >&2
    exit 1
fi

SCAN_STATUS=0
ERRORS=$(mktemp)
REPORT=$(mktemp)
trap 'rm -f "$ERRORS" "$REPORT"' EXIT
# Repository policy (or Gitleaks defaults) must win over global overrides.
unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML
# Gitleaks 8.30.1 cannot parse colored diffs. Override Git color only for this scan.
GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }'color.ui=false' 'color.diff=false'" \
gitleaks git --pre-commit --staged --exit-code "$GITLEAKS_FINDING_EXIT_CODE" --redact=100 --no-banner --log-level error \
    --report-format template --report-template "$HOOK_DIR/gitleaks-report.tmpl" \
    --report-path "$REPORT" 2>"$ERRORS" || SCAN_STATUS=$?
# Gitleaks can log Git-source errors while returning zero; that is not a clean scan.
if [ -s "$ERRORS" ]; then
    SCAN_STATUS=1
fi
if [ "$SCAN_STATUS" -ne 0 ] && [ "$SCAN_STATUS" -ne "$GITLEAKS_FINDING_EXIT_CODE" ]; then
    echo 'Gitleaks reported a Git or configuration error; no clean scan is available.' >&2
    cat <<'DIAGNOSTIC' >&2
For details, rerun privately from the repository root: (unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML; GIT_NO_LAZY_FETCH=1 GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }'color.ui=false' 'color.diff=false'" gitleaks git --pre-commit --staged --redact=100 --no-banner --log-level error)
DIAGNOSTIC
    exit "$SCAN_STATUS"
fi
cat "$REPORT"
if [ "$SCAN_STATUS" -eq "$GITLEAKS_FINDING_EXIT_CODE" ]; then
    echo 'Gitleaks blocked this commit. Remove staged credentials or add a reviewed public/test exception; see the shared secret-scanning guide.' >&2
    exit 1
fi
exit 0
